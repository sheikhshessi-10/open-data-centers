    {
      "name": "HF 2447 / HF 2690 (2026)",
      "status": "failed",
      "what": "HF 2447 would have required data centers to report water and electricity use and power source, required separate utility rates for data centers, and halted construction until the utility files data center rates (advanced from House subcommittee Feb 2026). HF 2690, which would have required separate rate classes for data centers, did not reach a floor vote (per Clean Energy Districts of Iowa). HF 2690 is probably the committee renumbering of HF 2447 (not verified; legislature site unreachable).",
      "source": "https://www.legis.iowa.gov/legislation/BillBook?ga=91&ba=HF%202690",
      "date": "2026"
    }
